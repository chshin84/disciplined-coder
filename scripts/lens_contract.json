{
  "common": { "lens": true, "read": true, "?target": true,
              "issues": [{ "where": true, "type": true, "claim": true, "file": true, "evidence": true,
                           "counterpart_file": true, "counterpart": true, "principle": true, "consequence": true }],
              "notes": true },
  "agents": {
    "lens-adversarial":       { "modes": ["design", "artifact"], "types": ["failure-mode", "over-engineering", "irreversible", "risk", "contradiction", "gap", "drift", "scope"], "extra": {}, "omit": [] },
    "lens-grounding":         { "modes": ["runtime", "spec", "doc"], "types": ["omission", "contradiction", "unsupported", "mismatch", "schema", "format", "constraint", "compat"], "extra": { "?doc_type": true }, "omit": [] },
    "lens-readability":       { "modes": ["text", "render"], "types": [], "extra": { "purpose": true, "suggestions": [{ "where": true, "why": true, "rewrite": true, "?screen": true }] }, "omit": ["issues"] },
    "lens-rebuttal":          { "modes": ["claim"], "types": ["counter-evidence", "weak-premise", "alternative-explanation", "missing-comparison"], "extra": { "queries": true }, "omit": [] }
  }
}
